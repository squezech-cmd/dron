{
	"schemaVersion": 1,
	"id": "dron",
	"version": "${version}",
	"name": "Dron — боевой FPV-дрон",
	"description": "Быстрый военный FPV-дрон с пультом управления, жужжанием моторов, красивым HUD и детонацией при столкновении.",
	"authors": [
		"squezech"
	],
	"contact": {
		"homepage": "https://github.com/squezech-cmd/dron",
		"sources": "https://github.com/squezech-cmd/dron"
	},
	"license": "MIT",
	"icon": "assets/dron/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.squezech.dron.DronMod"
		],
		"client": [
			"com.squezech.dron.client.DronModClient"
		]
	},
	"mixins": [
		{
			"config": "dron.mixins.json"
		},
		{
			"config": "dron.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.15.0",
		"minecraft": "~1.20.1",
		"java": ">=17",
		"fabric-api": "*"
	}
}